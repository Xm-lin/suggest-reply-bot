NATURAL_PROMPT_TEMPLATE = """
你是 18 歲的台灣年輕人，正躺在沙發上滑 Discord 跟朋友聊天。
請根據對話紀錄，擬定你（使用者）準備傳送的下句接話內容。

【語氣風格指南】
1. 極度簡短：1~15 個字內解決，能用幾個字表達就絕不多寫。
2. 真人隨意感：多用「欸、亂講、真的假、笑死、確實、好啊、無聊、還行」。
3. 標點規範：禁止使用驚嘆號「！」，句尾不要加句號，盡量不使用 Emoji。
4. 禁用 AI 罐頭詞：嚴禁「嗨嗨、很高興、超讚、當然、沒問題、很高興能為您提供服務」。
5. 直接輸出：不換行，不要引號，不要做任何補充或解釋，直接給出傳送內容。

對話情境：
{context}
"""

# =========================================================
# /reply
# =========================================================
@bot.tree.command(name="reply", description="生成極致自然的接話回覆")
@app_commands.describe(prompt="輸入對方說的話或話題")
async def reply(interaction: discord.Interaction, prompt: str):
    api_key = get_api_key(interaction.user.id)
    if not api_key:
        await interaction.response.send_message("❌ 請先使用 `/set_key` 設定你的 Gemini API Key！", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)

    try:
        full_prompt = NATURAL_PROMPT_TEMPLATE.format(context=f"對方說：{prompt}")
        reply_text = call_gemini_api(api_key, full_prompt)
        await interaction.followup.send(f"💡 **建議回覆：** {reply_text}", ephemeral=True)
    except Exception as e:
        print(f"❌ /reply Gemini 錯誤：{e}")
        await interaction.followup.send(f"⚠️ 發生錯誤：\n```text\n{str(e)[:1800]}\n```", ephemeral=True)

# =========================================================
# 右鍵選單：JARVIS 上下文分析建議回覆
# =========================================================
@app_commands.context_menu(name="JARVIS建議回覆")
async def jarvis_reply_context(interaction: discord.Interaction, message: discord.Message):
    api_key = get_api_key(interaction.user.id)
    if not api_key:
        await interaction.response.send_message("❌ 請先使用 `/set_key` 設定你的 Gemini API Key！", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)

    try:
        history_messages = []
        async for msg in interaction.channel.history(limit=6, before=message.created_at, oldest_first=True):
            if msg.content.strip():
                history_messages.append(f"{msg.author.display_name}: {msg.content}")
        
        history_messages.append(f"{message.author.display_name}: {message.content}")
        chat_context = "\n".join(history_messages)

        full_prompt = NATURAL_PROMPT_TEMPLATE.format(context=chat_context)
        reply_text = call_gemini_api(api_key, full_prompt)
        await interaction.followup.send(f"💡 **建議回覆：** {reply_text}", ephemeral=True)
    except Exception as e:
        print(f"❌ JARVIS 建議回覆錯誤：{e}")
        await interaction.followup.send(f"⚠️ 發生錯誤：\n```text\n{str(e)[:1800]}\n```", ephemeral=True)

# =========================================================
# 啟動 Bot
# =========================================================
bot.tree.add_command(jarvis_reply_context)

if __name__ == "__main__":
    init_db()
    token = os.environ.get("DISCORD_BOT_TOKEN")
    if not token:
        print("❌ 找不到 DISCORD_BOT_TOKEN 環境變數！")
    else:
        print("🚀 正在啟動 Discord Bot...")
        bot.run(token)
